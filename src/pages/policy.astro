---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer.astro';
import { companyInfo } from '@/lib/data';
---

<Layout
  title="Company Policy — BenignBit"
  description="Read BenignBit's company policy covering workplace conduct, equal opportunity, health and safety, data security, and professional standards."
  keywords="company policy, BenignBit policy, workplace policy, employee conduct"
  canonical="/policy"
>
  <Header client:load />
  <main class="pt-28 md:pt-36">
    <article class="container-page max-w-3xl pb-20">
      <h1 class="font-display text-4xl font-extrabold tracking-tight">Company Policy</h1>
      <p class="mt-2 text-sm text-muted-foreground">Last updated: January 2025</p>

      <div class="prose-custom mt-8 space-y-6 text-muted-foreground">
        <p>BenignBit ("we", "us", "our") is committed to maintaining a professional, safe and inclusive environment for our employees, contractors, clients and partners. This policy outlines the standards we uphold across our organization.</p>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Equal opportunity</h2>
          <p class="mt-3">We are an equal opportunity employer. We do not discriminate on the basis of race, color, religion, gender, gender identity, sexual orientation, national origin, age, disability, marital status or veteran status. Hiring, promotion and compensation decisions are based on qualifications, performance and business needs.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Workplace conduct</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>All team members are expected to treat colleagues, clients and partners with respect and professionalism.</li>
            <li>Harassment, discrimination or bullying of any kind is strictly prohibited and will result in disciplinary action up to and including termination.</li>
            <li>Conflicts of interest must be disclosed to management promptly.</li>
            <li>Confidential client information must never be shared outside authorized channels.</li>
          </ul>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Health and safety</h2>
          <p class="mt-3">We are committed to providing a safe and healthy work environment. We comply with all applicable occupational health and safety regulations. Employees are encouraged to report any unsafe conditions or practices immediately. Remote and in-office work arrangements are designed to support physical and mental well-being.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Data security</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>Access to client systems and data is granted on a least-privilege basis and reviewed regularly.</li>
            <li>All devices used for company work must use encryption, strong passwords and multi-factor authentication.</li>
            <li>Suspected security incidents must be reported to our security team within 24 hours.</li>
            <li>We conduct regular security training for all employees.</li>
          </ul>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Remote work</h2>
          <p class="mt-3">We support flexible and remote work arrangements where roles permit. Remote employees are expected to maintain reliable communication, meet agreed deadlines and ensure a secure working environment. Core collaboration hours are defined per team to ensure smooth coordination.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Code of ethics</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>We act with honesty, integrity and transparency in all business dealings.</li>
            <li>We protect client confidentiality and intellectual property at all times.</li>
            <li>We deliver work to the highest professional standard and stand behind its quality.</li>
            <li>We avoid situations that could compromise our objectivity or create conflicts of interest.</li>
          </ul>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Reporting concerns</h2>
          <p class="mt-3">Employees and partners who witness or experience conduct that violates this policy are encouraged to report it to management or via our confidential reporting channel. Retaliation against anyone who reports a concern in good faith is strictly prohibited.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Contact</h2>
          <p class="mt-3">Questions about this policy? Email <a href={`mailto:${companyInfo.email}`} class="text-primary hover:underline">{companyInfo.email}</a> or call {companyInfo.phone}.</p>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
