---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer.astro';
import { companyInfo } from '@/lib/data';
---

<Layout
  title="Privacy Policy — BenignBit"
  description="Read BenignBit's privacy policy to understand how we collect, use and protect your personal information."
  keywords="privacy policy, BenignBit privacy, data protection"
  canonical="/privacy"
>
  <Header client:load />
  <main class="pt-28 md:pt-36">
    <article class="container-page max-w-3xl pb-20">
      <h1 class="font-display text-4xl font-extrabold tracking-tight">Privacy Policy</h1>
      <p class="mt-2 text-sm text-muted-foreground">Last updated: January 2025</p>

      <div class="prose-custom mt-8 space-y-6 text-muted-foreground">
        <p>BenignBit ("we", "us", "our") respects your privacy. This policy explains what information we collect, how we use it, and the choices you have. By using our website and services, you agree to the practices described here.</p>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Information we collect</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li><strong class="text-foreground">Contact details</strong> — name, email, phone and company you provide via our quote or contact forms.</li>
            <li><strong class="text-foreground">Project details</strong> — information you share about your project scope, budget and timeline.</li>
            <li><strong class="text-foreground">Usage data</strong> — anonymous analytics such as pages visited and referring sites.</li>
          </ul>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">How we use your information</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>To respond to your inquiries and prepare project proposals.</li>
            <li>To deliver and improve the services we provide to you.</li>
            <li>To send occasional updates you can opt out of at any time.</li>
            <li>To analyze and improve our website performance.</li>
          </ul>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">How we protect your data</h2>
          <p class="mt-3">We use industry-standard security practices including encryption in transit, access controls and regular reviews. We never sell your personal information to third parties.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Cookies</h2>
          <p class="mt-3">Our site uses minimal cookies for analytics and functionality. You can disable cookies in your browser without affecting most features.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Your rights</h2>
          <p class="mt-3">You may request access to, correction of, or deletion of your personal data at any time by emailing us at <a href={`mailto:${companyInfo.email}`} class="text-primary hover:underline">{companyInfo.email}</a>.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Contact</h2>
          <p class="mt-3">Questions about this policy? Email <a href={`mailto:${companyInfo.email}`} class="text-primary hover:underline">{companyInfo.email}</a> or call {companyInfo.phone}.</p>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
