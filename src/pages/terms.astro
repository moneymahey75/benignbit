---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer.astro';
import { companyInfo } from '@/lib/data';
---

<Layout
  title="Terms of Service — BenignBit"
  description="Read BenignBit's terms of service governing the use of our website and the digital services we provide."
  keywords="terms of service, BenignBit terms, service agreement"
  canonical="/terms"
>
  <Header client:load />
  <main class="pt-28 md:pt-36">
    <article class="container-page max-w-3xl pb-20">
      <h1 class="font-display text-4xl font-extrabold tracking-tight">Terms of Service</h1>
      <p class="mt-2 text-sm text-muted-foreground">Last updated: January 2025</p>

      <div class="prose-custom mt-8 space-y-6 text-muted-foreground">
        <p>These terms govern your use of the BenignBit website and the services we provide. By engaging us or using our site, you accept these terms.</p>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Services</h2>
          <p class="mt-3">BenignBit provides website development, software development, mobile app development, digital marketing, SEO and UI/UX design services. The specific scope, timeline and pricing of any engagement will be defined in a separate agreement or proposal.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Client responsibilities</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>Provide accurate and timely information required for the project.</li>
            <li>Review deliverables and provide feedback within agreed timeframes.</li>
            <li>Ensure you own or have rights to any content you supply to us.</li>
          </ul>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Payment</h2>
          <p class="mt-3">Project fees, milestones and payment schedules are defined in your individual proposal. Invoices are due within the stated terms. Late payments may pause ongoing work.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Intellectual property</h2>
          <p class="mt-3">Upon full payment, ownership of custom deliverables transfers to the client, except for third-party libraries, tools and pre-existing components we retain rights to. We may showcase completed work in our portfolio unless agreed otherwise in writing.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Warranty and liability</h2>
          <p class="mt-3">We warrant our work will be free from material defects for 30 days after delivery. To the fullest extent permitted by law, our liability is limited to the fees paid for the specific engagement giving rise to the claim.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Termination</h2>
          <p class="mt-3">Either party may terminate an engagement with written notice. Fees for work completed up to the termination date remain payable.</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-foreground">Contact</h2>
          <p class="mt-3">Questions about these terms? Email <a href={`mailto:${companyInfo.email}`} class="text-primary hover:underline">{companyInfo.email}</a> or call {companyInfo.phone}.</p>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
