---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer.astro';
import { ArrowRight, Target, Eye, Heart, Award, Rocket } from 'lucide-react';
import { stats, services } from '@/lib/data';

const teamImg = 'https://images.pexels.com/photos/6804071/pexels-photo-6804071.jpeg?auto=compress&cs=tinysrgb&h=650&w=940';
const cultureImg = 'https://images.pexels.com/photos/7988758/pexels-photo-7988758.jpeg?auto=compress&cs=tinysrgb&h=650&w=940';

const values = [
  { Icon: Target, title: 'Outcome-driven', text: 'We measure success by your business results, not by lines of code.' },
  { Icon: Heart, title: 'Honest partnership', text: 'Transparent communication and no surprises — you always know where your project stands.' },
  { Icon: Award, title: 'Craftsmanship', text: 'We sweat the details so your product feels polished, fast and reliable.' },
  { Icon: Rocket, title: 'Move fast', text: 'Agile sprints, frequent demos and shipping momentum over perfection paralysis.' },
];

const milestones = [
  { year: '2017', title: 'BenignBit founded', text: 'Started as a two-person web studio with a focus on small business websites.' },
  { year: '2019', title: 'Expanded into software', text: 'Began building custom dashboards and SaaS products for growing clients.' },
  { year: '2021', title: 'Launched mobile practice', text: 'Added native and cross-platform mobile app development to our services.' },
  { year: '2023', title: 'Full digital agency', text: 'Brought SEO and performance marketing in-house to offer end-to-end growth.' },
  { year: '2025', title: '250+ projects shipped', text: 'Now a 30-person team serving clients across 15 countries.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About BenignBit',
  description: 'Learn about BenignBit, a full-service IT company with 8+ years of experience building websites, software and mobile apps.',
};
---

<Layout
  title="About BenignBit — Our Story, Mission & Team"
  description="BenignBit is an IT company with 8+ years of experience and 250+ projects delivered. Meet the team behind fast websites, custom software and growth-driven marketing."
  keywords="about BenignBit, IT company team, software company history, web development agency about"
  canonical="/about"
  jsonLd={jsonLd}
>
  <Header client:load />

  <main>
    {/* Hero */}
    <section class="relative overflow-hidden border-b border-border pt-28 md:pt-36">
      <div class="absolute inset-0 grid-pattern opacity-40"></div>
      <div class="absolute -right-32 top-10 h-80 w-80 rounded-full bg-accent/20 blur-3xl"></div>
      <div class="container-page relative pb-16">
        <span class="text-sm font-semibold uppercase tracking-wider text-primary">About us</span>
        <h1 class="mt-3 max-w-3xl font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
          We build the digital products that move your business forward
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          BenignBit is a full-service IT company founded in 2017. We help startups and established businesses launch websites, software and mobile apps — and grow them with SEO and digital marketing.
        </p>
      </div>
    </section>

    {/* Stats */}
    <section class="border-b border-border bg-card py-12">
      <div class="container-page grid grid-cols-2 gap-6 lg:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <p class="font-display text-3xl font-bold text-primary md:text-4xl">{s.value}</p>
            <p class="mt-1 text-sm text-muted-foreground">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Mission / Vision */}
    <section class="section-padding">
      <div class="container-page grid gap-10 lg:grid-cols-2">
        <div class="rounded-2xl border border-border bg-card p-8 md:p-10">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <Target class="h-6 w-6" />
          </span>
          <h2 class="mt-5 font-display text-2xl font-bold">Our mission</h2>
          <p class="mt-3 leading-relaxed text-muted-foreground">
            To help every business — regardless of size — compete online with fast, beautiful and reliable digital products. We believe great engineering should be accessible, not exclusive to tech giants.
          </p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-8 md:p-10">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 text-accent">
            <Eye class="h-6 w-6" />
          </span>
          <h2 class="mt-5 font-display text-2xl font-bold">Our vision</h2>
          <p class="mt-3 leading-relaxed text-muted-foreground">
            To be the most trusted technology partner for growing businesses worldwide — the team you call when you need something built right, built fast and built to last.
          </p>
        </div>
      </div>
    </section>

    {/* Story with image */}
    <section class="section-padding bg-secondary/40">
      <div class="container-page grid items-center gap-14 lg:grid-cols-2">
        <div class="relative">
          <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-primary/20 to-accent/20 blur-2xl"></div>
          <img src={teamImg} alt="BenignBit team working together" width="940" height="650" loading="lazy" class="relative aspect-[4/3] w-full rounded-2xl border border-border object-cover shadow-xl" />
        </div>
        <div>
          <span class="text-sm font-semibold uppercase tracking-wider text-primary">Our story</span>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">From a two-person studio to a full digital team</h2>
          <p class="mt-4 leading-relaxed text-muted-foreground">
            BenignBit started in 2017 as a small web studio building websites for local businesses. Over the years, our clients grew — and so did the problems they needed solved. We expanded into custom software, mobile apps, SEO and performance marketing.
          </p>
          <p class="mt-4 leading-relaxed text-muted-foreground">
            Today we are a 30-person team of engineers, designers and marketers who have shipped over 250 projects across 15 countries. We still hold onto the same principle we started with: treat every client's project like it is our own.
          </p>

          <div class="mt-8 space-y-4">
            {milestones.map((m) => (
              <div class="flex gap-4">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-border bg-background font-display text-sm font-bold text-primary">{m.year}</span>
                <div>
                  <p class="font-semibold text-foreground">{m.title}</p>
                  <p class="mt-0.5 text-sm text-muted-foreground">{m.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Values */}
    <section class="section-padding">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-sm font-semibold uppercase tracking-wider text-primary">Our values</span>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">What we believe in</h2>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {values.map(({ Icon, title, text }) => (
            <div class="rounded-2xl border border-border bg-card p-6 transition-all hover:-translate-y-1 hover:shadow-lg">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <Icon class="h-6 w-6" />
              </span>
              <h3 class="mt-5 text-lg font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Culture image band */}
    <section class="relative overflow-hidden border-y border-border">
      <img src={cultureImg} alt="BenignBit team culture and collaboration" width="940" height="650" loading="lazy" class="h-[320px] w-full object-cover md:h-[420px]" />
      <div class="absolute inset-0 bg-gradient-to-r from-foreground/80 to-foreground/20"></div>
      <div class="container-page relative flex h-full items-center">
        <div class="max-w-xl py-16">
          <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">A culture of ownership and curiosity</h2>
          <p class="mt-4 leading-relaxed text-white/85">
            Our team is made of people who genuinely love building things. We invest in learning, ship often, and take real ownership of every project we touch.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {['Remote-first', 'Learning budget', 'Open source contributors', 'Hack weeks'].map((t) => (
              <span class="rounded-full border border-white/30 bg-white/10 px-4 py-2 text-sm text-white backdrop-blur">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="section-padding">
      <div class="container-page">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary to-accent px-6 py-16 text-center shadow-2xl md:px-16">
          <div class="absolute inset-0 grid-pattern opacity-10"></div>
          <div class="relative">
            <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">Want to work with us?</h2>
            <p class="mx-auto mt-4 max-w-xl text-white/90">Whether you have a project in mind or just want to explore ideas, we would love to hear from you.</p>
            <div class="mt-8 flex flex-wrap justify-center gap-4">
              <a href="/get-quote" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3.5 text-sm font-semibold text-primary shadow-lg transition-transform hover:-translate-y-0.5">
                Get a Free Quote <ArrowRight class="h-4 w-4" />
              </a>
              <a href="/contact" class="inline-flex items-center gap-2 rounded-lg border border-white/40 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10">
                Contact Us
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
