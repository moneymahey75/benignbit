---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer.astro';
import { ArrowRight, Check, Star, TrendingUp, Sparkles, ShieldCheck, Zap } from 'lucide-react';
import { services, projects, testimonials, stats, industries } from '@/lib/data';

const heroImg = 'https://images.pexels.com/photos/6804068/pexels-photo-6804068.jpeg?auto=compress&cs=tinysrgb&h=650&w=940';
const whyImg = 'https://images.pexels.com/photos/7988745/pexels-photo-7988745.jpeg?auto=compress&cs=tinysrgb&h=650&w=940';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BenignBit',
  url: 'https://benignbit.com',
  logo: 'https://benignbit.com/favicon.svg',
  description: 'IT company offering website development, software development, mobile apps, digital marketing, SEO and UI/UX design.',
  sameAs: [
    'https://twitter.com/benignbit',
    'https://linkedin.com/company/benignbit',
    'https://github.com/benignbit',
  ],
};
---

<Layout
  title="BenignBit — IT Company | Web, Software, Mobile & Digital Marketing"
  description="BenignBit is a full-service IT company building fast websites, custom software, mobile apps and growth-driven digital marketing campaigns for businesses worldwide."
  keywords="IT company, web development company, software development, mobile app development, digital marketing agency, SEO services, UI UX design, BenignBit"
  canonical="/"
  jsonLd={jsonLd}
>
  <Header client:load />

  <main>
    {/* Hero */}
    <section class="relative overflow-hidden pt-28 md:pt-36">
      <div class="absolute inset-0 grid-pattern opacity-50"></div>
      <div class="absolute -left-40 top-20 h-96 w-96 rounded-full bg-primary/20 blur-3xl"></div>
      <div class="absolute -right-40 top-40 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>

      <div class="container-page relative pb-20 md:pb-28">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-4 py-1.5 text-xs font-medium text-muted-foreground backdrop-blur">
              <Sparkles class="h-3.5 w-3.5 text-primary" />
              Trusted by 120+ businesses worldwide
            </span>
            <h1 class="mt-6 font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
              Building digital products that <span class="text-gradient">grow your business</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
              BenignBit is a full-service IT company. We design and develop high-performance websites, custom software and mobile apps — and market them with data-driven SEO and digital campaigns.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/get-quote" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:bg-primary/90 hover:shadow-xl">
                Get a Free Quote <ArrowRight class="h-4 w-4" />
              </a>
              <a href="/portfolio" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3.5 text-sm font-semibold text-foreground transition-colors hover:bg-secondary">
                View Our Work
              </a>
            </div>
            <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
              {['No long-term contracts', 'Free project consultation', 'Delivery on time, every time'].map((t) => (
                <span class="flex items-center gap-2 text-sm text-muted-foreground">
                  <Check class="h-4 w-4 text-accent" /> {t}
                </span>
              ))}
            </div>
          </div>

          <div class="relative">
            <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-primary/30 to-accent/30 blur-2xl"></div>
            <img
              src={heroImg}
              alt="BenignBit software development team building digital products"
              width="940" height="650"
              loading="eager"
              class="relative aspect-[4/3] w-full rounded-2xl border border-border object-cover shadow-2xl"
            />
            <div class="absolute -bottom-6 -left-6 hidden rounded-xl border border-border bg-card p-4 shadow-xl sm:block">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent/10 text-accent">
                  <TrendingUp class="h-5 w-5" />
                </span>
                <div>
                  <p class="text-xl font-bold text-foreground">250+</p>
                  <p class="text-xs text-muted-foreground">Projects delivered</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-20 grid grid-cols-2 gap-6 border-t border-border pt-10 lg:grid-cols-4">
          {stats.map((s) => (
            <div class="text-center">
              <p class="font-display text-3xl font-bold text-primary md:text-4xl">{s.value}</p>
              <p class="mt-1 text-sm text-muted-foreground">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Services */}
    <section class="section-padding bg-secondary/40">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-sm font-semibold uppercase tracking-wider text-primary">What we do</span>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">Services built to scale your business</h2>
          <p class="mt-4 text-muted-foreground">From a single landing page to a full digital platform, we cover every layer of your online presence under one roof.</p>
        </div>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s) => (
            <a href={`/services/${s.slug}`} class="group relative overflow-hidden rounded-2xl border border-border bg-card p-6 transition-all hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/0 to-accent/0 opacity-0 transition-opacity group-hover:from-primary/5 group-hover:to-accent/5 group-hover:opacity-100"></div>
              <span class="relative flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
                <s.icon class="h-6 w-6" />
              </span>
              <h3 class="relative mt-5 text-lg font-semibold text-foreground">{s.title}</h3>
              <p class="relative mt-2 text-sm leading-relaxed text-muted-foreground">{s.short}</p>
              <span class="relative mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary">
                Learn more <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* Why us */}
    <section class="section-padding">
      <div class="container-page grid items-center gap-14 lg:grid-cols-2">
        <div class="relative order-last lg:order-first">
          <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-primary/20 to-accent/20 blur-2xl"></div>
          <img src={whyImg} alt="BenignBit team collaborating on a project" width="940" height="650" loading="lazy" class="relative aspect-[4/3] w-full rounded-2xl border border-border object-cover shadow-xl" />
        </div>
        <div>
          <span class="text-sm font-semibold uppercase tracking-wider text-primary">Why BenignBit</span>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">A partner that ships, not a vendor that talks</h2>
          <p class="mt-4 text-muted-foreground">We combine engineering excellence with business sense. Every project is built to be fast, reliable and measurable — so you see real returns, not just pretty screens.</p>
          <ul class="mt-8 space-y-5">
            {[
              { Icon: Zap, title: 'Speed and performance first', text: 'We obsess over Core Web Vitals and load times because they directly impact your rankings and conversions.' },
              { Icon: ShieldCheck, title: 'Secure and maintainable', text: 'Clean architecture, modern best practices and security built in from day one — not bolted on later.' },
              { Icon: TrendingUp, title: 'ROI-focused delivery', text: 'Every feature we ship is tied to a business outcome. We measure and report on what matters.' },
            ].map(({ Icon, title, text }) => (
              <li class="flex gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <Icon class="h-5 w-5" />
                </span>
                <div>
                  <p class="font-semibold text-foreground">{title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* Industries */}
    <section class="border-y border-border bg-card py-12">
      <div class="container-page">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-muted-foreground">Industries we serve</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          {industries.map((ind) => (
            <span class="rounded-full border border-border bg-background px-4 py-2 text-sm text-foreground/80 transition-colors hover:border-primary hover:text-primary">{ind}</span>
          ))}
        </div>
      </div>
    </section>

    {/* Featured projects */}
    <section class="section-padding bg-secondary/40">
      <div class="container-page">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-2xl">
            <span class="text-sm font-semibold uppercase tracking-wider text-primary">Portfolio</span>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">Recent work we are proud of</h2>
          </div>
          <a href="/portfolio" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
            View all projects <ArrowRight class="h-4 w-4" />
          </a>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {projects.slice(0, 4).map((p) => (
            <a href={`/portfolio/${p.slug}`} class="group overflow-hidden rounded-2xl border border-border bg-card transition-all hover:-translate-y-1 hover:shadow-xl">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src={p.image} alt={`${p.title} — ${p.category} project by BenignBit`} width="940" height="650" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                <span class="absolute left-4 top-4 rounded-full bg-background/90 px-3 py-1 text-xs font-semibold text-foreground backdrop-blur">{p.category}</span>
              </div>
              <div class="p-6">
                <p class="text-xs text-muted-foreground">{p.client} · {p.year}</p>
                <h3 class="mt-1 text-lg font-semibold text-foreground">{p.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.summary}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {p.tags.slice(0, 3).map((t) => (
                    <span class="rounded-md bg-secondary px-2.5 py-1 text-xs font-medium text-muted-foreground">{t}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* Testimonials */}
    <section class="section-padding">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-sm font-semibold uppercase tracking-wider text-primary">Testimonials</span>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">What our clients say</h2>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {testimonials.map((t) => (
            <figure class="flex flex-col rounded-2xl border border-border bg-card p-6">
              <div class="flex gap-0.5 text-accent">
                {Array.from({ length: t.rating }).map(() => <Star class="h-4 w-4 fill-current" />)}
              </div>
              <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-foreground/90">"{t.quote}"</blockquote>
              <figcaption class="mt-5 border-t border-border pt-4">
                <p class="text-sm font-semibold text-foreground">{t.name}</p>
                <p class="text-xs text-muted-foreground">{t.role}, {t.company}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="section-padding">
      <div class="container-page">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary to-accent px-6 py-16 text-center shadow-2xl md:px-16">
          <div class="absolute inset-0 grid-pattern opacity-10"></div>
          <div class="relative">
            <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">Let's build something great together</h2>
            <p class="mx-auto mt-4 max-w-xl text-white/90">Tell us about your project and get a free, no-obligation quote within 24 hours.</p>
            <div class="mt-8 flex flex-wrap justify-center gap-4">
              <a href="/get-quote" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3.5 text-sm font-semibold text-primary shadow-lg transition-transform hover:-translate-y-0.5">
                Get a Free Quote <ArrowRight class="h-4 w-4" />
              </a>
              <a href="/contact" class="inline-flex items-center gap-2 rounded-lg border border-white/40 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10">
                Contact Us
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
