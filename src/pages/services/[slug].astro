---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer.astro';
import { ArrowRight, Check, ArrowLeft } from 'lucide-react';
import { services } from '@/lib/data';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = services.find((s) => s.slug === slug)!;

const related = services.filter((s) => s.slug !== slug).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.description,
  provider: { '@type': 'Organization', name: 'BenignBit', url: 'https://benignbit.com' },
  areaServed: 'Worldwide',
  serviceType: service.title,
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title={`${service.title} — BenignBit`}
  description={service.description}
  keywords={`${service.title.toLowerCase()}, ${service.title.toLowerCase().replace(/ /g, ',')}, BenignBit`}
  canonical={`/services/${service.slug}`}
  jsonLd={[jsonLd, faqLd]}
>
  <Header client:load />

  <main>
    <section class="relative overflow-hidden border-b border-border pt-28 md:pt-36">
      <div class="absolute inset-0 grid-pattern opacity-40"></div>
      <div class="absolute -right-32 top-10 h-80 w-80 rounded-full bg-accent/20 blur-3xl"></div>
      <div class="container-page relative pb-16">
        <a href="/services" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-primary">
          <ArrowLeft class="h-4 w-4" /> All services
        </a>
        <div class="mt-6 grid items-center gap-10 lg:grid-cols-2">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
              <service.icon class="h-3.5 w-3.5" /> {service.title}
            </span>
            <h1 class="mt-4 font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
              {service.title}
            </h1>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">{service.short}</p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/get-quote" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:bg-primary/90">
                Get a Free Quote <ArrowRight class="h-4 w-4" />
              </a>
              <a href="/contact" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3.5 text-sm font-semibold text-foreground transition-colors hover:bg-secondary">
                Talk to an expert
              </a>
            </div>
          </div>
          <div class="relative">
            <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-primary/20 to-accent/20 blur-2xl"></div>
            <div class="relative flex aspect-[4/3] items-center justify-center rounded-2xl border border-border bg-gradient-to-br from-primary/5 to-accent/10">
              <service.icon class="h-28 w-28 text-primary/50" strokeWidth={1.2} />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Overview */}
    <section class="section-padding">
      <div class="container-page grid gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <h2 class="font-display text-3xl font-bold tracking-tight">Overview</h2>
          <p class="mt-4 leading-relaxed text-muted-foreground">{service.description}</p>

          <h3 class="mt-10 font-display text-xl font-semibold">What's included</h3>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {service.features.map((f) => (
              <li class="flex items-start gap-2.5 rounded-lg border border-border bg-card p-3.5 text-sm text-foreground/90">
                <Check class="mt-0.5 h-4 w-4 shrink-0 text-accent" /> {f}
              </li>
            ))}
          </ul>
        </div>

        <aside class="space-y-6">
          <div class="rounded-2xl border border-border bg-card p-6">
            <h3 class="font-display text-lg font-semibold">Key benefits</h3>
            <ul class="mt-4 space-y-3">
              {service.benefits.map((b) => (
                <li class="flex items-start gap-2.5 text-sm text-foreground/90">
                  <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary" /> {b}
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-2xl border border-primary/30 bg-primary/5 p-6">
            <h3 class="font-display text-lg font-semibold">Ready to start?</h3>
            <p class="mt-2 text-sm text-muted-foreground">Get a tailored proposal within 24 hours.</p>
            <a href="/get-quote" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground">
              Get a Quote <ArrowRight class="h-4 w-4" />
            </a>
          </div>
        </aside>
      </div>
    </section>

    {/* Process */}
    <section class="section-padding bg-secondary/40">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-sm font-semibold uppercase tracking-wider text-primary">How we work</span>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">Our {service.title.toLowerCase()} process</h2>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {service.process.map((p, i) => (
            <div class="relative rounded-2xl border border-border bg-card p-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary font-display text-sm font-bold text-primary-foreground">{i + 1}</span>
              <h3 class="mt-4 font-semibold">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* FAQs */}
    <section class="section-padding">
      <div class="container-page max-w-3xl">
        <div class="text-center">
          <span class="text-sm font-semibold uppercase tracking-wider text-primary">FAQ</span>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">Frequently asked questions</h2>
        </div>
        <div class="mt-10 space-y-4">
          {service.faqs.map((f) => (
            <details class="group rounded-xl border border-border bg-card p-5 [&_summary]:cursor-pointer">
              <summary class="flex items-center justify-between font-semibold text-foreground list-none">
                {f.q}
                <span class="text-primary transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* Related */}
    <section class="section-padding bg-secondary/40">
      <div class="container-page">
        <h2 class="font-display text-2xl font-bold tracking-tight">Related services</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          {related.map((s) => (
            <a href={`/services/${s.slug}`} class="group rounded-2xl border border-border bg-card p-6 transition-all hover:-translate-y-1 hover:shadow-lg">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <s.icon class="h-5 w-5" />
              </span>
              <h3 class="mt-4 font-semibold">{s.title}</h3>
              <p class="mt-2 text-sm text-muted-foreground">{s.short}</p>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-primary">
                Learn more <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
