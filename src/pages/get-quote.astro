---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer.astro';
import QuoteForm from '@/components/QuoteForm';
import { Check, Clock, ShieldCheck, Gift } from 'lucide-react';

const perks = [
  { Icon: Clock, title: '24-hour response', text: 'A specialist reviews your request and replies within one business day.' },
  { Icon: Gift, title: 'No cost or commitment', text: 'The quote is free and there is no obligation to proceed.' },
  { Icon: ShieldCheck, title: 'Confidential', text: 'Your details stay private. We never share or sell your information.' },
];
---

<Layout
  title="Get a Free Quote — BenignBit"
  description="Request a free, no-obligation project quote from BenignBit. Tell us about your website, software, app or marketing project and get a tailored proposal within 24 hours."
  keywords="get a quote, free quote, project quote, web development quote, software development quote, BenignBit quote"
  canonical="/get-quote"
>
  <Header client:load />

  <main>
    <section class="relative overflow-hidden border-b border-border pt-28 md:pt-36">
      <div class="absolute inset-0 grid-pattern opacity-40"></div>
      <div class="absolute -right-32 top-10 h-80 w-80 rounded-full bg-accent/20 blur-3xl"></div>
      <div class="container-page relative pb-16">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-sm font-semibold uppercase tracking-wider text-primary">Get a quote</span>
          <h1 class="mt-3 font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
            Tell us about your project
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
            Fill out the form below and receive a tailored, no-obligation proposal within 24 hours. The more detail you share, the more accurate your quote will be.
          </p>
        </div>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-page grid gap-10 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <QuoteForm client:load />
        </div>
        <aside class="lg:col-span-2 space-y-6">
          <div class="rounded-2xl border border-border bg-card p-6">
            <h2 class="font-display text-lg font-semibold">What happens next?</h2>
            <ol class="mt-4 space-y-4">
              {['We review your request within 24 hours', 'A specialist schedules a quick discovery call', 'You receive a tailored proposal with timeline and pricing', 'We kick off once you give the green light'].map((step, i) => (
                <li class="flex gap-3">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground">{i + 1}</span>
                  <p class="text-sm text-foreground/90">{step}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="space-y-4">
            {perks.map(({ Icon, title, text }) => (
              <div class="flex gap-4 rounded-2xl border border-border bg-card p-5">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
                  <Icon class="h-5 w-5" />
                </span>
                <div>
                  <p class="font-semibold text-foreground">{title}</p>
                  <p class="mt-0.5 text-sm text-muted-foreground">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
