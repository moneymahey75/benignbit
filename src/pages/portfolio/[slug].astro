---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer.astro';
import { ArrowRight, ArrowLeft, ExternalLink, Check } from 'lucide-react';
import { projects } from '@/lib/data';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = projects.find((p) => p.slug === slug)!;

const related = projects.filter((p) => p.slug !== slug && p.category === project.category).slice(0, 3);
const fallback = projects.filter((p) => p.slug !== slug).slice(0, 3);
const more = related.length ? related : fallback;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.description,
  creator: { '@type': 'Organization', name: 'BenignBit' },
  datePublished: project.year,
  about: project.category,
};
---

<Layout
  title={`${project.title} — BenignBit Portfolio`}
  description={project.summary}
  keywords={`${project.title}, ${project.tags.join(', ')}, BenignBit portfolio`}
  canonical={`/portfolio/${project.slug}`}
  jsonLd={jsonLd}
>
  <Header client:load />

  <main>
    <section class="relative overflow-hidden border-b border-border pt-28 md:pt-36">
      <div class="absolute inset-0 grid-pattern opacity-40"></div>
      <div class="container-page relative pb-12">
        <a href="/portfolio" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-primary">
          <ArrowLeft class="h-4 w-4" /> Back to portfolio
        </a>
        <div class="mt-6 grid items-center gap-10 lg:grid-cols-2">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">{project.category}</span>
            <h1 class="mt-4 font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{project.title}</h1>
            <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted-foreground">{project.summary}</p>
            <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
              <div><dt class="text-muted-foreground">Client</dt><dd class="font-semibold text-foreground">{project.client}</dd></div>
              <div><dt class="text-muted-foreground">Year</dt><dd class="font-semibold text-foreground">{project.year}</dd></div>
              <div><dt class="text-muted-foreground">Category</dt><dd class="font-semibold text-foreground">{project.category}</dd></div>
            </dl>
          </div>
          <div class="relative">
            <div class="absolute -inset-3 rounded-3xl bg-gradient-to-br from-primary/20 to-accent/20 blur-2xl"></div>
            <img src={project.image} alt={`${project.title} — ${project.category} project by BenignBit`} width="940" height="650" loading="eager" class="relative aspect-[4/3] w-full rounded-2xl border border-border object-cover shadow-xl" />
          </div>
        </div>
      </div>
    </section>

    {/* Results */}
    <section class="border-b border-border bg-card py-12">
      <div class="container-page">
        <h2 class="text-center font-display text-2xl font-bold tracking-tight">Results delivered</h2>
        <div class="mt-8 grid grid-cols-2 gap-6 lg:grid-cols-4">
          {project.results.map((r) => (
            <div class="text-center">
              <p class="font-display text-3xl font-bold text-primary md:text-4xl">{r.value}</p>
              <p class="mt-1 text-sm text-muted-foreground">{r.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Body */}
    <section class="section-padding">
      <div class="container-page grid gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <h2 class="font-display text-3xl font-bold tracking-tight">The challenge</h2>
          <p class="mt-4 leading-relaxed text-muted-foreground">{project.description}</p>

          <h3 class="mt-10 font-display text-xl font-semibold">What we did</h3>
          <ul class="mt-4 space-y-3">
            {project.tags.map((t) => (
              <li class="flex items-start gap-2.5 text-sm text-foreground/90">
                <Check class="mt-0.5 h-4 w-4 shrink-0 text-accent" /> {t} expertise applied to this engagement
              </li>
            ))}
          </ul>

          {project.url && (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-2 rounded-lg border border-border bg-card px-5 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-secondary">
              Visit live site <ExternalLink class="h-4 w-4" />
            </a>
          )}
        </div>

        <aside class="space-y-6">
          <div class="rounded-2xl border border-border bg-card p-6">
            <h3 class="font-display text-lg font-semibold">Technologies</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.tags.map((t) => (
                <span class="rounded-md bg-secondary px-2.5 py-1 text-xs font-medium text-muted-foreground">{t}</span>
              ))}
            </div>
          </div>
          <div class="rounded-2xl border border-primary/30 bg-primary/5 p-6">
            <h3 class="font-display text-lg font-semibold">Want similar results?</h3>
            <p class="mt-2 text-sm text-muted-foreground">Tell us about your project and we'll show you how.</p>
            <a href="/get-quote" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground">
              Get a Quote <ArrowRight class="h-4 w-4" />
            </a>
          </div>
        </aside>
      </div>
    </section>

    {/* More projects */}
    <section class="section-padding bg-secondary/40">
      <div class="container-page">
        <h2 class="font-display text-2xl font-bold tracking-tight">More projects</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          {more.map((p) => (
            <a href={`/portfolio/${p.slug}`} class="group overflow-hidden rounded-2xl border border-border bg-card transition-all hover:-translate-y-1 hover:shadow-lg">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src={p.image} alt={`${p.title} — ${p.category}`} width="940" height="650" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </div>
              <div class="p-4">
                <p class="text-xs text-muted-foreground">{p.category}</p>
                <h3 class="mt-1 text-sm font-semibold text-foreground">{p.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
